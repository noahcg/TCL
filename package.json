{
  "name": "the-cascade-lounge",
  "description": "A static CSS publication with articles, Quick Wins, resources, and local search.",
  "version": "2.15.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "admin": "npm run build && node --env-file-if-exists=.env.local scripts/admin.mjs",
    "desktop:setup": "npm run desktop:prepare && node scripts/run-desktop.mjs setup",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && node scripts/run-desktop.mjs dev",
    "desktop:package": "npm run desktop:prepare && node scripts/run-desktop.mjs package",
    "desktop:install": "node scripts/install-desktop.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run content:verify && npm test && npm run build",
    "verify:all": "npm run verify && npm run test:browser",
    "content:verify": "node scripts/migration/import-apex.mjs",
    "content:import": "node scripts/migration/import-apex.mjs --apply",
    "content:capture": "node scripts/migration/capture-apex.mjs",
    "images:plan": "node scripts/article-images.mjs --plan",
    "images:generate": "node --env-file-if-exists=.env.local scripts/article-images.mjs",
    "images:import": "node scripts/article-images.mjs --import",
    "content:prepare": "npm run images:generate && npm run verify"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@vercel/analytics": "2.0.1",
    "highlight.js": "11.12.0",
    "marked": "15.0.12",
    "mdn-data": "2.38.0",
    "parse5": "8.1.1",
    "sanitize-html": "2.18.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.59.1"
  }
}
