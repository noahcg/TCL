# Optional production HTTPS origin. Use your real domain; omit the trailing slash.
# Set this in your shell or hosting environment. The build does not load .env files.
# TCL_SITE_URL=https://your-domain.example

# Netlify supplies CONTEXT=production and URL for production deployments.
# Vercel supplies VERCEL_ENV and VERCEL_PROJECT_PRODUCTION_URL automatically.
# Local and preview builds stay noindex by default.

# Optional publishing-only image generation. Put the real key in ignored .env.local.
# images:generate loads .env.local; the site build and browser never use this key.
# OPENAI_API_KEY=
# TCL_IMAGE_MODEL=gpt-image-2
