# Optional production HTTPS origin. Use your real domain; omit the trailing slash.
# Set this in your shell or hosting environment. The build does not load .env files.
# TCL_SITE_URL=https://your-domain.example

# Netlify supplies CONTEXT=production and URL for production deployments.
# Vercel supplies VERCEL_ENV and VERCEL_PROJECT_PRODUCTION_URL automatically.
# Local and preview builds stay noindex by default.

# Public GA4 measurement ID, used only in HTTPS production builds on either host.
# Defaults to G-6XZZLW4VFL. Set an empty value in the hosting environment to disable GA4.
# TCL_GA_MEASUREMENT_ID=G-6XZZLW4VFL

# Optional publishing-only image generation. Put the real key in ignored .env.local.
# images:generate loads .env.local; the site build and browser never use this key.
# OPENAI_API_KEY=
# TCL_IMAGE_MODEL=gpt-image-2

# Private, local editorial studio (npm run admin). Uses the same OPENAI_API_KEY.
# Optional model with Responses API web_search and structured output support.
# TCL_EDITOR_MODEL=gpt-6.2-astra
# TCL_ADMIN_PORT=4174
# Live approval uses your existing GitHub Git credentials and the production remote.
# TCL_LIVE_REMOTE=vercel
# TCL_SITE_URL also adds an "Open live page" link after submission.
